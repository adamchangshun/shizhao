:root{--bg:#fff8f3;--surface:#ffffff;--primary:#d64545;--accent:#f2b84b;--text:#2b1d1a;
--on-primary:#ffffff;--on-accent:#1a1a1a;
--font-h:"SZ Heading", "Songti SC", "STSong", "SimSun", serif;--font-b:"SZ Body", system-ui, -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;--fw-h:400}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font-b);font-size:16px;line-height:1.6;overflow-wrap:anywhere;padding-bottom:calc(76px + env(safe-area-inset-bottom))}
img{display:block;max-width:100%;height:auto}
h1,h2,h3,p{margin:0}
.page{max-width:480px;margin:0 auto;overflow-x:hidden;min-height:100vh}
.fh{font-family:var(--font-h);font-weight:var(--fw-h);line-height:1.25}
.price{white-space:nowrap}
.price-unit{font-size:.8em;opacity:.75}
.price-unit::before{content:"/"}
.tags{display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:8px 0 0;list-style:none}
.tag{font-size:13px;line-height:1.4;padding:2px 8px;border-radius:999px;background:color-mix(in srgb,var(--accent) 18%,transparent)}
.claims{display:flex;flex-wrap:wrap;gap:8px;padding:0;margin:0;list-style:none}
.claim{font-size:15px;padding:4px 12px;border-radius:999px;border:1px solid color-mix(in srgb,var(--primary) 45%,transparent)}
.shop-info{margin:24px 16px 0;padding:16px;border-radius:14px;background:var(--surface)}
.shop-info dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:6px 12px;font-size:15px}
.shop-info dl>div{display:contents}.shop-info dt{opacity:.7}.shop-info dd{margin:0;min-width:0}
.closing{margin:24px 16px 0;text-align:center;font-size:17px}
.footer{margin:24px 16px 0;padding:16px 0 24px;text-align:center;font-size:13px;line-height:1.7;opacity:.7}
.footer p{margin:0}
.actions{position:fixed;left:0;right:0;bottom:0;z-index:10;display:flex;gap:8px;justify-content:center;
padding:10px 12px calc(10px + env(safe-area-inset-bottom));background:var(--bg);background:color-mix(in srgb,var(--bg) 92%,transparent);
border-top:1px solid color-mix(in srgb,var(--text) 10%,transparent)}
.act{flex:1 1 0;max-width:160px;min-width:0;min-height:48px;display:flex;align-items:center;justify-content:center;
padding:0 10px;border:0;border-radius:12px;font:inherit;font-size:16px;text-decoration:none;cursor:pointer;
background:var(--primary);color:var(--on-primary)}
.act:nth-child(2){background:var(--accent);color:var(--on-accent)}
.act:focus-visible{outline:3px solid var(--text);outline-offset:2px}
.toast{position:fixed;left:50%;bottom:calc(84px + env(safe-area-inset-bottom));transform:translateX(-50%);z-index:20;
padding:8px 16px;border-radius:999px;background:#1a1a1a;color:#ffffff;font-size:15px}
.page{background-image:radial-gradient(circle at 77% 55%,var(--accent) 0 3px,transparent 4px),radial-gradient(circle at 36% 26%,var(--primary) 0 2px,transparent 3px),radial-gradient(circle at 95% 97%,var(--accent) 0 2px,transparent 3px);background-size:140px 160px,110px 130px,90px 120px}
@media (prefers-reduced-motion:no-preference){@keyframes sz-rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}.rise{animation:sz-rise .6s ease-out both}.rise:nth-child(2){animation-delay:.08s}.rise:nth-child(3){animation-delay:.16s}}

.poster .p-hero{position:relative;overflow:hidden}
.poster .p-hero-img{width:100%;aspect-ratio:4/5;object-fit:cover;background:var(--surface)}
.poster .p-hero-text{padding:20px 20px 8px}
.poster .p-shop{font-size:15px;letter-spacing:.12em;opacity:.8;margin-bottom:6px}
.poster .p-headline{font-size:clamp(32px,10vw,46px);letter-spacing:.02em}
.poster .p-subhead{margin-top:10px;font-size:17px;opacity:.85}
.poster.hero-full-bleed .p-hero-text{position:absolute;left:0;right:0;bottom:0;padding:72px 20px 22px;color:#ffffff;
background:linear-gradient(to top,rgba(0,0,0,.72),rgba(0,0,0,0))}
.poster.hero-full-bleed.no-img .p-hero-text,.poster.no-img .p-hero-text{position:static;color:var(--on-primary);background:var(--primary);padding:56px 20px 32px}
.poster.hero-split .p-hero{display:grid;grid-template-columns:1fr 1fr;align-items:end;gap:0;background:var(--surface)}
.poster.hero-split .p-hero-img{aspect-ratio:3/5;order:2}
.poster.hero-split .p-hero-text{padding:24px 14px}
.poster.hero-split .p-headline{font-size:clamp(26px,8vw,36px)}
.poster.hero-split.no-img .p-hero{display:block}
.poster.hero-stacked .p-hero{padding:16px 16px 0}
.poster.hero-stacked .p-hero-img{aspect-ratio:1/1;border-radius:20px}
.poster.hero-stacked .p-hero-text{padding:20px 4px 4px}
.poster .p-feature{margin:20px 16px 0;padding:20px;border-radius:18px;background:var(--surface);
box-shadow:0 10px 30px -18px color-mix(in srgb,var(--text) 45%,transparent)}
.poster .p-feature-name{font-size:24px}
.poster .p-feature-price{display:inline-block;margin-top:6px;font-size:30px;font-weight:700;color:var(--primary)}
.poster .p-spec{margin-top:4px;font-size:15px;opacity:.75}
.poster .p-desc{margin-top:10px}
.poster .p-blurb{margin-top:12px;padding-left:12px;border-left:3px solid var(--accent);font-size:15px}
.poster .p-claims{margin:20px 16px 0}
.poster .p-more{margin:32px 16px 0}
.poster .p-more-title{font-size:20px;margin-bottom:12px}
.poster .p-more-list{list-style:none;margin:0;padding:0;display:grid;gap:12px}
.poster .p-more-item{display:flex;gap:12px;padding:12px;border-radius:14px;background:var(--surface)}
.poster .p-more-img{flex:0 0 88px;width:88px;height:88px;object-fit:cover;border-radius:10px}
.poster .p-more-body{min-width:0;flex:1}
.poster .p-more-head{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.poster .p-more-name{font-size:17px}
.poster .p-more-price{font-weight:700;color:var(--primary)}
</style></head><body data-track="/api/track" data-slug="k7m2xq" data-version="ver_0001"><div class="page t-poster deco-confetti"><main class="poster hero-full-bleed"><header class="p-hero"><img src="media/img_cake01-display.webp" alt="草莓奶油蛋糕" width="750" height="938" class="p-hero-img" fetchPriority="high" decoding="async"/><div class="p-hero-text"><p class="p-shop" data-fact="shop.name">甜心烘焙坊</p><h1 class="fh p-headline rise">一口就是春天</h1><p class="p-subhead rise">当季草莓，配上轻盈奶油</p></div></header><div class="deco-rule" aria-hidden="true"></div><section class="p-feature rise" aria-label="主推商品"><h2 class="fh p-feature-name" data-fact="items.ab12cd34.name">草莓奶油蛋糕</h2><span class="price p-feature-price"><span data-fact="items.ab12cd34.price">¥128</span><span class="price-unit" data-fact="items.ab12cd34.price.unit">6 寸</span></span><p class="p-spec" data-fact="items.ab12cd34.spec">约 450g</p><p class="p-desc" data-fact="items.ab12cd34.description">当季草莓配动物奶油，每日现做。</p><ul class="tags"><li class="tag" data-fact="items.ab12cd34.tags.0">招牌</li><li class="tag" data-fact="items.ab12cd34.tags.1">需预订</li></ul><p class="p-blurb">切开那一刻，满满都是果香。</p></section><section class="p-claims" aria-label="店家承诺"><ul class="claims"><li class="claim" data-fact="extraClaims.0">当天现烤</li></ul></section><p class="closing">欢迎到店，我们等你来尝。</p></main><section class="shop-info" aria-label="店铺信息"><dl><div><dt>营业时间</dt><dd data-fact="shop.hours">每天 8:00-21:00</dd></div><div><dt>地址</dt><dd data-fact="shop.address">上海市徐汇区漕溪北路 88 号</dd></div><div><dt>电话</dt><dd data-fact="shop.phone">021-6488 1234</dd></div><div><dt>微信</dt><dd data-fact="shop.wechat">tianxin_bake</dd></div></dl></section><footer class="footer"><p>本页由 AI 辅助设计，商品信息由商家提供</p><p>由 实招 Shizhao 生成</p></footer></div><nav class="actions" aria-label="联系商家"><a class="act" href="tel:021-64881234" data-act="call">一键拨号</a><button class="act" type="button" data-act="wechat_copy" data-copy="tianxin_bake">复制微信号</button><a class="act" href="https://uri.amap.com/search?