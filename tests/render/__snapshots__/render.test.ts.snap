:root{--bg:#fff8f3;--surface:#ffffff;--primary:#d64545;--accent:#f2b84b;--text:#2b1d1a;
--on-primary:#ffffff;--on-accent:#1a1a1a;
--font-h:"SZ Heading", "Songti SC", "STSong", "SimSun", serif;--font-b:"SZ Body", system-ui, -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;--fw-h:400}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font-b);font-size:16px;line-height:1.6;overflow-wrap:anywhere;padding-bottom:calc(76px + env(safe-area-inset-bottom))}
img{display:block;max-width:100%;height:auto}
h1,h2,h3,p{margin:0}
.page{max-width:480px;margin:0 auto;overflow-x:hidden;min-height:100vh}
.fh{font-family:var(--font-h);font-weight:var(--fw-h);line-height:1.25}
.price{display:inline-flex;flex-wrap:wrap;align-items:baseline;max-width:100%}.price>span{white-space:nowrap}
.price-unit{font-size:max(15px,.8em);opacity:.75}
.price-unit::before{content:"/"}
.tags{display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:8px 0 0;list-style:none}
.tag{font-size:13px;line-height:1.4;padding:2px 8px;border-radius:999px;background:color-mix(in srgb,var(--accent) 18%,transparent)}
.claims{display:flex;flex-wrap:wrap;gap:8px;padding:0;margin:0;list-style:none}
.claim{font-size:15px;padding:4px 12px;border-radius:999px;border:1px solid color-mix(in srgb,var(--primary) 45%,transparent)}
.shop-info{margin:24px 16px 0;padding:16px;border-radius:14px;background:var(--surface)}
.shop-info dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:6px 12px;font-size:15px}
.shop-info dl>div{display:contents}.shop-info dt{opacity:.7}.shop-info dd{margin:0;min-width:0}
.closing{margin:24px 16px 0;text-align:center;font-size:17px}
.footer{margin:24px 16px 0;padding:16px 0 24px;text-align:center;font-size:13px;line-height:1.7;opacity:.7}
.footer p{margin:0}
.actions{position:fixed;left:0;right:0;bottom:0;z-index:10;display:flex;gap:8px;justify-content:center;
padding:10px 12px calc(10px + env(safe-area-inset-bottom));background:var(--bg);background:color-mix(in srgb,var(--bg) 92%,transparent);
border-top:1px solid color-mix(in srgb,var(--text) 10%,transparent)}
.act{flex:1 1 0;max-width:160px;min-width:0;min-height:48px;display:flex;align-items:center;justify-content:center;
padding:0 10px;border:0;border-radius:12px;font:inherit;font-size:16px;text-decoration:none;cursor:pointer;
background:var(--primary);color:var(--on-primary)}
.act:nth-child(2){background:var(--accent);color:var(--on-accent)}
.act:focus-visible{outline:3px solid var(--text);outline-offset:2px}
.toast{position:fixed;left:50%;bottom:calc(84px + env(safe-area-inset-bottom));transform:translateX(-50%);z-index:20;
padding:8px 16px;border-radius:999px;background:#1a1a1a;color:#ffffff;font-size:15px}
.fix{margin:24px 16px 0;font-size:15px}
.fix summary{cursor:pointer;opacity:.75;text-decoration:underline;text-underline-offset:3px;min-height:44px;display:flex;align-items:center;justify-content:center;list-style:none}
.fix summary::-webkit-details-marker{display:none}
.fix form{display:grid;gap:10px;margin-top:8px;padding:16px;border-radius:14px;background:var(--surface)}
.fix label{display:grid;gap:4px}
.fix select,.fix input,.fix textarea{font:inherit;font-size:16px;color:var(--text);background:var(--bg);border:1px solid color-mix(in srgb,var(--text) 30%,transparent);border-radius:8px;padding:8px 10px;min-height:44px;max-width:100%;box-sizing:border-box;width:100%}
.fix button{font:inherit;min-height:44px;border:0;border-radius:10px;background:var(--primary);color:var(--on-primary)}
.fix-tip{margin:0;font-size:15px;opacity:.75}
.fix [hidden]{display:none}
#sz-fix-msg{margin:0}
.page{background-image:radial-gradient(circle at 77% 55%,var(--accent) 0 3px,transparent 4px),radial-gradient(circle at 36% 26%,var(--primary) 0 2px,transparent 3px),radial-gradient(circle at 95% 97%,var(--accent) 0 2px,transparent 3px);background-size:140px 160px,110px 130px,90px 120px}
@media (prefers-reduced-motion:no-preference){@keyframes sz-rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}.rise{animation:sz-rise .6s ease-out both}.rise:nth-child(2){animation-delay:.08s}.rise:nth-child(3){animation-delay:.16s}}

.poster .p-hero{position:relative;overflow:hidden}
.poster .p-hero-img{width:100%;aspect-ratio:4/5;object-fit:cover;background:var(--surface)}
.poster .p-hero-text{padding:20px 20px 8px}
.poster .p-shop{font-size:15px;letter-spacing:.12em;opacity:.8;margin-bottom:6px}
.poster .p-headline{font-size:clamp(32px,10vw,46px);letter-spacing:.02em}
.poster .p-subhead{margin-top:10px;font-size:17px;opacity:.85}
.poster.hero-full-bleed .p-hero-text{position:absolute;left:0;right:0;bottom:0;padding:72px 20px 22px;color:#ffffff;
background:linear-gradient(to top,rgba(0,0,0,.72),rgba(0,0,0,0))}
.poster.hero-full-bleed.no-img .p-hero-text,.poster.no-img .p-hero-text{position:static;color:var(--on-primary);background:var(--primary);padding:56px 20px 32px}
.poster.hero-split .p-hero{display:grid;grid-template-columns:1fr 1fr;align-items:end;gap:0;background:var(--surface)}
.poster.hero-split .p-hero-img{aspect-ratio:3/5;order:2}
.poster.hero-split .p-hero-text{padding:24px 14px}
.poster.hero-split .p-headline{font-size:clamp(26px,8vw,36px)}
.poster.hero-split.no-img .p-hero{display:block}
.poster.hero-stacked .p-hero{padding:16px 16px 0}
.poster.hero-stacked .p-hero-img{aspect-ratio:1/1;border-radius:20px}
.poster.hero-stacked .p-hero-text{padding:20px 4px 4px}
.poster .p-feature{margin:20px 16px 0;padding:20px;border-radius:18px;background:var(--surface);
box-shadow:0 10px 30px -18px color-mix(in srgb,var(--text) 45%,transparent)}
.poster .p-feature-name{font-size:24px}
.poster .p-feature-price{display:inline-block;margin-top:6px;font-size:30px;font-weight:700;color:var(--primary)}
.poster .p-spec{margin-top:4px;font-size:15px;opacity:.75}
.poster .p-desc{margin-top:10px}
.poster .p-blurb{margin-top:12px;padding-left:12px;border-left:3px solid var(--accent);font-size:15px}
.poster .p-claims{margin:20px 16px 0}
.poster .p-more{margin:32px 16px 0}
.poster .p-more-title{font-size:20px;margin-bottom:12px}
.poster .p-more-list{list-style:none;margin:0;padding:0;display:grid;gap:12px}
.poster .p-more-item{display:flex;gap:12px;padding:12px;border-radius:14px;background:var(--surface)}
.poster .p-more-img{flex:0 0 88px;width:88px;height:88px;object-fit:cover;border-radius:10px}
.poster .p-more-body{min-width:0;flex:1}
.poster .p-more-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:8px}
.poster .p-more-name{font-size:17px}
.poster .p-more-price{font-weight:700;color:var(--primary)}
</style></head><body data-track="/api/track" data-slug="k7m2xq" data-version="ver_0001"><div class="page t-poster deco-confetti"><main class="poster hero-full-bleed"><header class="p-hero"><img src="media/img_menu01-display.webp" alt="美式咖啡" width="750" height="938" class="p-hero-img" fetchPriority="high" decoding="async"/><div class="p-hero-text"><p class="p-shop" data-fact="shop.name">巷口咖啡</p><h1 class="fh p-headline rise">巷口的第一杯</h1><p class="p-subhead rise">早上好，从一杯热咖啡开始</p></div></header><div class="deco-rule" aria-hidden="true"></div><section class="p-feature rise" aria-label="主推商品"><h2 class="fh p-feature-name" data-fact="items.m1aa0001.name">美式咖啡</h2><span class="price p-feature-price"><span data-fact="items.m1aa0001.price">¥18</span><span class="price-unit" data-fact="items.m1aa0001.price.unit">杯</span></span><p class="p-spec" data-fact="items.m1aa0001.spec">大杯 473ml</p><p class="p-blurb">清爽不苦，配什么都好。</p></section><section class="p-claims" aria-label="店家承诺"><ul class="claims"><li class="claim" data-fact="extraClaims.0">自家烘焙豆子</li><li class="claim" data-fact="extraClaims.1">可外带</li></ul></section><section class="p-more" aria-label="更多商品"><h2 class="fh p-more-title">店里还有</h2><ul class="p-more-list"><li class="p-more-item"><img src="media/img_menu02-thumb.webp" alt="拿铁" width="240" height="240" class="p-more-img" loading="lazy" decoding="async"/><div class="p-more-body"><div class="p-more-head"><h3 class="fh p-more-name" data-fact="items.m1aa0002.name">拿铁</h3><span class="price p-more-price"><span data-fact="items.m1aa0002.price">¥22.50</span><span class="price-unit" data-fact="items.m1aa0002.price.unit">杯</span></span></div><p class="p-desc" data-fact="items.m1aa0002.description">意式浓缩加热牛奶。</p></div></li><li class="p-more-item"><img src="media/img_menu03-thumb.webp" alt="燕麦拿铁" width="240" height="240" class="p-more-img" loading="lazy" decoding="async"/><div class="p-more-body"><div class="p-more-head"><h3 class="fh p-more-name" data-fact="items.m1aa0003.name">燕麦拿铁</h3><span class="price p-more-price"><span data-fact="items.m1aa0003.price">¥25</span><span class="price-unit" data-fact="items.m1aa0003.price.unit">杯</span></span></div></div></li><li class="p-more-item"><div class="p-more-body"><div class="p-more-head"><h3 class="fh p-more-name" data-fact="items.m1aa0004.name">柠檬气泡美式</h3><span class="price p-more-price"><span data-fact="items.m1aa0004.price">¥26</span><span class="price-unit" data-fact="items.m1aa0004.price.unit">杯</span></span></div><ul class="tags"><li class="tag" data-fact="items.m1aa0004.tags.0">夏季限定</li></ul></div></li><li class="p-more-item"><div class="p-more-body"><div class="p-more-head"><h3 class="fh p-more-name" data-fact="items.m1aa0005.name">可颂</h3><span class="price p-more-price"><span data-fact="items.m1aa0005.price">¥12.50</span><span class="price-unit" data-fact="items.m1aa0005.price.unit">个</span></span></div></div></li><li class="p-more-item"><div class="p-more-body"><div class="p-more-head"><h3 class="fh p-more-name" data-fact="items.m1aa0006.name">肉桂卷</h3><span class="price p-more-price"><span data-fact="items.m1aa0006.price">¥16</span><span class="price-unit" data-fact="items.m1aa0006.price.unit">个</span></span></div></div></li><li class="p-more-item"><div class="p-more-body"><div class="p-more-head"><h3 class="fh p-more-name" data-fact="items.m1aa0007.name">芒果千层</h3><span class="price p-more-price"><span data-fact="items.m1aa0007.price">¥32</span><span class="price-unit" data-fact="items.m1aa0007.price.unit">份</span></span></div><p class="p-blurb">层层叠叠的芒果香。</p></div></li><li class="p-more-item"><div class="p-more-body"><div class="p-more-head"><h3 class="fh p-more-name" data-fact="items.m1aa0008.name">巧克力布朗尼</h3><span class="price p-more-price"><span data-fact="items.m1aa0008.price">¥18.80</span><span class="price-unit" data-fact="items.m1aa0008.price.unit">块</span></span></div></div></li></ul></section><p class="closing">路过的话，进来坐坐。</p></main><section class="shop-info" aria-label="店铺信息"><dl><div><dt>营业时间</dt><dd data-fact="shop.hours">周一至周日 7:30-19:00</dd></div><div><dt>地址</dt><dd data-fact="shop.address">杭州市西湖区文三路 12 号</dd></div><div><dt>电话</dt><dd data-fact="shop.phone">13800001234</dd></div><div><dt>微信</dt><dd data-fact="shop.wechat">xiangkou-coffee</dd></div></dl></section><details class="fix"><summary>信息有误？告诉老板</summary><form id="sz-fix" data-api="/api/corrections" noValidate=""><label>哪一项有误<select name="field"><option value="items.m1aa0001.name">美式咖啡 · 名称</option><option value="items.m1aa0001.price">美式咖啡 · 价格</option><option value="items.m1aa0001.spec">美式咖啡 · 规格</option><option value="items.m1aa0002.name">拿铁 · 名称</option><option value="items.m1aa0002.price">拿铁 · 价格</option><option value="items.m1aa0002.description">拿铁 · 介绍</option><option value="items.m1aa0003.name">燕麦拿铁 · 名称</option><option value="items.m1aa0003.price">燕麦拿铁 · 价格</option><option value="items.m1aa0004.name">柠檬气泡美式 · 名称</option><option value="items.m1aa0004.price">柠檬气泡美式 · 价格</option><option value="items.m1aa0005.name">可颂 · 名称</option><option value="items.m1aa0005.price">可颂 · 价格</option><option value="items.m1aa0006.name">肉桂卷 · 名称</option><option value="items.m1aa0006.price">肉桂卷 · 价格</option><option value="items.m1aa0007.name">芒果千层 · 名称</option><option value="items.m1aa0007.price">芒果千层 · 价格</option><option value="items.m1aa0008.name">巧克力布朗尼 · 名称</option><option value="items.m1aa0008.price">巧克力布朗尼 · 价格</option><option value="shop.name">店名</option><option value="shop.phone" data-nv="1">电话联系不上或有误</option><option value="shop.wechat" data-nv="1">微信联系不上或有误</option><option value="shop.address">地址</option><option value="shop.hours">营业时间</option><option value="other">其他</option></select></label><label id="sz-fix-v">正确的是<input maxLength="100" autoComplete="off" name="sv"/></label><label>补充说明（选填）<textarea name="note" maxLength="200" rows="2"></textarea></label><p class="fix-tip">请勿填写你的手机号等个人信息</p><button type="submit">提交</button><p id="sz-fix-msg" role="status" aria-live="polite" hidden=""><span>已转告老板，谢谢你</span><span>提交失败，请稍后再试</span><span>请勿填写个人信息</span><span>请填写正确的内容</span></p></form></details><footer class="footer"><p>本页由 AI 辅助设计，商品信息由商家提供</p><p>由 实招 Shizhao 生成</p></footer></div><nav class="actions" aria-label="联系商家"><a class="act" href="tel:13800001234" data-act="call">一键拨号</a><button class="act" type="button" data-act="wechat_copy" data-copy="xiangkou-coffee">复制微信号</button><a class="act" href="https://surl.amap.com/abc123" data-act="navigate" rel="noopener noreferrer">地图导航</a></nav><p id="sz-toast" class="toast" role="status" aria-live="polite" hidden=""><span>已复制</span><span hidden="">请长按微信号手动复制</span></p><script>(function(){
var b=document.body,d=b.dataset,t=d.track,src='link';
try{if(new URLSearchParams(location.search).get('src')==='qr')src='qr'}catch(e){}
function send(a){if(!t)return;try{
var p=JSON.stringify({slug:d.slug,versionId:d.version,source:src,action:a});
if(navigator.sendBeacon&&navigator.sendBeacon(t,new Blob([p],{type:'application/json'})))return;
fetch(t,{method:'POST',body:p,keepalive:true,headers:{'Content-Type':'application/json'}}).catch(function(){})
}catch(e){}}
var toast=document.getElementById('sz-toast'),timer;
function show(ok){if(!toast)return;toast.hidden=false;toast.children[0].hidden=!ok;toast.children[1].hidden=ok;
clearTimeout(timer);timer=setTimeout(function(){toast.hidden=true},2000)}
function fallback(v){var ok=false,x=document.createElement('textarea');x.value=v;x.setAttribute('readonly','');
x.style.position='fixed';x.style.opacity='0';b.appendChild(x);x.select();
try{ok=document.execCommand('copy')}catch(e){}b.removeChild(x);show(ok)}
function copy(v){if(navigator.clipboard&&window.isSecureContext){
navigator.clipboard.writeText(v).then(function(){show(true)},function(){fallback(v)})}else fallback(v)}
document.addEventListener('click',function(e){
var el=e.target&&e.target.closest?e.target.closest('[data-act]'):null;if(!el)return;
var a=el.getAttribute('data-act');if(a==='wechat_copy')copy(el.getAttribute('data-copy')||'');send(a)});
var f=document.getElementById('sz-fix');if(f){var E=f.elements,F=E.field,V=document.getElementById('sz-fix-v'),M=document.getElementById('sz-fix-msg');
function nv(){var o=F.options[F.selectedIndex];V.hidden=!!(o&&o.hasAttribute('data-nv'))}
function say(i){M.hidden=false;for(var k=0;k<M.children.length;k++)M.children[k].hidden=k!==i}
