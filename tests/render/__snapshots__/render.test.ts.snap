:root{--bg:#f1f5ef;--surface:#ffffff;--primary:#2f6b4f;--accent:#e07a3f;--text:#1d2a22;
--on-primary:#ffffff;--on-accent:#1a1a1a;
--font-h:"SZ Heading", "Songti SC", "STSong", "SimSun", serif;--font-b:"SZ Body", system-ui, -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;--fw-h:700}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font-b);font-size:16px;line-height:1.6;overflow-wrap:anywhere;padding-bottom:calc(76px + env(safe-area-inset-bottom))}
img{display:block;max-width:100%;height:auto}
h1,h2,h3,p{margin:0}
.page{max-width:480px;margin:0 auto;overflow-x:hidden;min-height:100vh}
.fh{font-family:var(--font-h);font-weight:var(--fw-h);line-height:1.25}
.price{display:inline-flex;flex-wrap:wrap;align-items:baseline;max-width:100%}.price>span{white-space:nowrap}
.price-unit{font-size:max(15px,.8em);opacity:.75}
.price-unit::before{content:"/"}
.tags{display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:8px 0 0;list-style:none}
.tag{font-size:13px;line-height:1.4;padding:2px 8px;border-radius:999px;background:color-mix(in srgb,var(--accent) 18%,transparent)}
.claims{display:flex;flex-wrap:wrap;gap:8px;padding:0;margin:0;list-style:none}
.claim{font-size:15px;padding:4px 12px;border-radius:999px;border:1px solid color-mix(in srgb,var(--primary) 45%,transparent)}
.shop-info{margin:24px 16px 0;padding:16px;border-radius:14px;background:var(--surface)}
.shop-info dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:6px 12px;font-size:15px}
.shop-info dl>div{display:contents}.shop-info dt{opacity:.7}.shop-info dd{margin:0;min-width:0}
.closing{margin:24px 16px 0;text-align:center;font-size:17px}
.footer{margin:24px 16px 0;padding:16px 0 24px;text-align:center;font-size:13px;line-height:1.7;opacity:.7}
.footer p{margin:0}
.actions{position:fixed;left:0;right:0;bottom:0;z-index:10;display:flex;gap:8px;justify-content:center;
padding:10px 12px calc(10px + env(safe-area-inset-bottom));background:var(--bg);background:color-mix(in srgb,var(--bg) 92%,transparent);
border-top:1px solid color-mix(in srgb,var(--text) 10%,transparent)}
.act{flex:1 1 0;max-width:160px;min-width:0;min-height:48px;display:flex;align-items:center;justify-content:center;
padding:0 10px;border:0;border-radius:12px;font:inherit;font-size:16px;text-decoration:none;cursor:pointer;
background:var(--primary);color:var(--on-primary)}
.act:nth-child(2){background:var(--accent);color:var(--on-accent)}
.act:focus-visible{outline:3px solid var(--text);outline-offset:2px}
.toast{position:fixed;left:50%;bottom:calc(84px + env(safe-area-inset-bottom));transform:translateX(-50%);z-index:20;
padding:8px 16px;border-radius:999px;background:#1a1a1a;color:#ffffff;font-size:15px}
.fix{margin:24px 16px 0;font-size:15px}
.fix summary{cursor:pointer;opacity:.75;text-decoration:underline;text-underline-offset:3px;min-height:44px;display:flex;align-items:center;justify-content:center;list-style:none}
.fix summary::-webkit-details-marker{display:none}
.fix form{display:grid;gap:10px;margin-top:8px;padding:16px;border-radius:14px;background:var(--surface)}
.fix label{display:grid;gap:4px}
.fix select,.fix input,.fix textarea{font:inherit;font-size:16px;color:var(--text);background:var(--bg);border:1px solid color-mix(in srgb,var(--text) 30%,transparent);border-radius:8px;padding:8px 10px;min-height:44px;max-width:100%;box-sizing:border-box;width:100%}
.fix button{font:inherit;min-height:44px;border:0;border-radius:10px;background:var(--primary);color:var(--on-primary)}
.fix-tip{margin:0;font-size:15px;opacity:.75}
.fix [hidden]{display:none}
#sz-fix-msg{margin:0}
.page{background-image:radial-gradient(color-mix(in srgb,var(--text) 7%,transparent) 1px,transparent 1px);background-size:5px 5px}


.card-stack .c-header{padding:36px 20px 28px;background:var(--primary);color:var(--on-primary);border-radius:0 0 28px 28px}
.card-stack .c-shop{font-size:18px;opacity:.9}
.card-stack .c-headline{margin-top:10px;font-size:clamp(28px,8.5vw,40px)}
.card-stack .c-subhead{margin-top:8px;font-size:16px;opacity:.9}
.card-stack .c-header .claims{margin-top:16px}
.card-stack .c-header .claim{border-color:currentColor}
.card-stack .c-list{list-style:none;margin:20px 0 0;padding:0 16px;display:grid;gap:18px}
.card-stack .c-card{position:relative;overflow:hidden;border-radius:20px;background:var(--surface);
box-shadow:0 1px 0 color-mix(in srgb,var(--text) 8%,transparent),0 14px 28px -20px color-mix(in srgb,var(--text) 60%,transparent)}
.card-stack .c-img{width:100%;aspect-ratio:3/2;object-fit:cover;background:var(--bg)}
.card-stack .c-body{position:relative;padding:18px 18px 20px}
.card-stack .c-index{position:absolute;top:-22px;right:16px;min-width:44px;height:44px;padding:0 8px;display:flex;align-items:center;justify-content:center;
border-radius:999px;background:var(--accent);color:var(--on-accent);font-size:15px;font-weight:700}
.card-stack .c-card-plain .c-index{position:static;display:inline-flex;margin-bottom:10px}
.card-stack .c-head{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 12px}
.card-stack .c-name{font-size:21px;min-width:0}
.card-stack .c-price{font-size:22px;font-weight:700;color:var(--primary)}
.card-stack .c-spec{margin-top:2px;font-size:15px;opacity:.7}
.card-stack .c-desc{margin-top:8px}
.card-stack .c-blurb{margin-top:10px;font-size:15px;color:color-mix(in srgb,var(--text) 80%,var(--primary))}
</style></head><body data-track="/api/track" data-slug="k7m2xq" data-version="ver_0001"><div class="page t-card-stack deco-grain"><main class="card-stack"><header class="c-header"><p class="fh c-shop" data-fact="shop.name">甜心烘焙坊</p><h1 class="fh c-headline">一口就是春天</h1><p class="c-subhead">当季草莓，配上轻盈奶油</p><ul class="claims"><li class="claim" data-fact="extraClaims.0">当天现烤</li></ul></header><div class="deco-rule" aria-hidden="true"></div><ol class="c-list" aria-label="商品"><li class="c-card rise"><img src="media/img_cake01-display.webp" alt="草莓奶油蛋糕" width="686" height="458" class="c-img" fetchPriority="high" decoding="async"/><div class="c-body"><span class="c-index" aria-hidden="true">01</span><div class="c-head"><h2 class="fh c-name" data-fact="items.ab12cd34.name">草莓奶油蛋糕</h2><span class="price c-price"><span data-fact="items.ab12cd34.price">¥128</span><span class="price-unit" data-fact="items.ab12cd34.price.unit">6 寸</span></span></div><p class="c-spec" data-fact="items.ab12cd34.spec">约 450g</p><p class="c-desc" data-fact="items.ab12cd34.description">当季草莓配动物奶油，每日现做。</p><ul class="tags"><li class="tag" data-fact="items.ab12cd34.tags.0">招牌</li><li class="tag" data-fact="items.ab12cd34.tags.1">需预订</li></ul><p class="c-blurb">切开那一刻，满满都是果香。</p></div></li></ol><p class="closing">欢迎到店，我们等你来尝。</p></main><section class="shop-info" aria-label="店铺信息"><dl><div><dt>营业时间</dt><dd data-fact="shop.hours">每天 8:00-21:00</dd></div><div><dt>地址</dt><dd data-fact="shop.address">上海市徐汇区漕溪北路 88 号</dd></div><div><dt>电话</dt><dd data-fact="shop.phone">021-6488 1234</dd></div><div><dt>微信</dt><dd data-fact="shop.wechat">tianxin_bake</dd></div></dl></section><details class="fix"><summary>信息有误？告诉老板</summary><form id="sz-fix" data-api="/api/corrections" noValidate=""><label>哪一项有误<select name="field"><option value="items.ab12cd34.name">草莓奶油蛋糕 · 名称</option><option value="items.ab12cd34.price">草莓奶油蛋糕 · 价格</option><option value="items.ab12cd34.spec">草莓奶油蛋糕 · 规格</option><option value="items.ab12cd34.descr