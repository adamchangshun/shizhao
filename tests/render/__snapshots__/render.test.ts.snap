:root{--bg:#1f2a24;--surface:#28362e;--primary:#f3d27a;--accent:#e8a87c;--text:#f4efe4;
--on-primary:#1a1a1a;--on-accent:#1a1a1a;
--font-h:"SZ Heading", "Kaiti SC", "STKaiti", "KaiTi", serif;--font-b:"SZ Body", "Kaiti SC", "STKaiti", "KaiTi", serif;--fw-h:700}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font-b);font-size:16px;line-height:1.6;overflow-wrap:anywhere;padding-bottom:calc(76px + env(safe-area-inset-bottom))}
img{display:block;max-width:100%;height:auto}
h1,h2,h3,p{margin:0}
.page{max-width:480px;margin:0 auto;overflow-x:hidden;min-height:100vh}
.fh{font-family:var(--font-h);font-weight:var(--fw-h);line-height:1.25}
.price{display:inline-flex;flex-wrap:wrap;align-items:baseline;max-width:100%}.price>span{white-space:nowrap}
.price-unit{font-size:max(15px,.8em);opacity:.75}
.price-unit::before{content:"/"}
.tags{display:flex;flex-wrap:wrap;gap:6px;padding:0;margin:8px 0 0;list-style:none}
.tag{font-size:13px;line-height:1.4;padding:2px 8px;border-radius:999px;background:color-mix(in srgb,var(--accent) 18%,transparent)}
.claims{display:flex;flex-wrap:wrap;gap:8px;padding:0;margin:0;list-style:none}
.claim{font-size:15px;padding:4px 12px;border-radius:999px;border:1px solid color-mix(in srgb,var(--primary) 45%,transparent)}
.shop-info{margin:24px 16px 0;padding:16px;border-radius:14px;background:var(--surface)}
.shop-info dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:6px 12px;font-size:15px}
.shop-info dl>div{display:contents}.shop-info dt{opacity:.7}.shop-info dd{margin:0;min-width:0}
.closing{margin:24px 16px 0;text-align:center;font-size:17px}
.footer{margin:24px 16px 0;padding:16px 0 24px;text-align:center;font-size:13px;line-height:1.7;opacity:.7}
.footer p{margin:0}
.actions{position:fixed;left:0;right:0;bottom:0;z-index:10;display:flex;gap:8px;justify-content:center;
padding:10px 12px calc(10px + env(safe-area-inset-bottom));background:var(--bg);background:color-mix(in srgb,var(--bg) 92%,transparent);
border-top:1px solid color-mix(in srgb,var(--text) 10%,transparent)}
.act{flex:1 1 0;max-width:160px;min-width:0;min-height:48px;display:flex;align-items:center;justify-content:center;
padding:0 10px;border:0;border-radius:12px;font:inherit;font-size:16px;text-decoration:none;cursor:pointer;
background:var(--primary);color:var(--on-primary)}
.act:nth-child(2){background:var(--accent);color:var(--on-accent)}
.act:focus-visible{outline:3px solid var(--text);outline-offset:2px}
.toast{position:fixed;left:50%;bottom:calc(84px + env(safe-area-inset-bottom));transform:translateX(-50%);z-index:20;
padding:8px 16px;border-radius:999px;background:#1a1a1a;color:#ffffff;font-size:15px}
.fix{margin:24px 16px 0;font-size:15px}
.fix summary{cursor:pointer;opacity:.75;text-decoration:underline;text-underline-offset:3px;min-height:44px;display:flex;align-items:center;justify-content:center;list-style:none}
.fix summary::-webkit-details-marker{display:none}
.fix form{display:grid;gap:10px;margin-top:8px;padding:16px;border-radius:14px;background:var(--surface)}
.fix label{display:grid;gap:4px}
.fix select,.fix input,.fix textarea{font:inherit;font-size:16px;color:var(--text);background:var(--bg);border:1px solid color-mix(in srgb,var(--text) 30%,transparent);border-radius:8px;padding:8px 10px;min-height:44px;max-width:100%;box-sizing:border-box;width:100%}
.fix button{font:inherit;min-height:44px;border:0;border-radius:10px;background:var(--primary);color:var(--on-primary)}
.fix-tip{margin:0;font-size:15px;opacity:.75}
.fix [hidden]{display:none}
#sz-fix-msg{margin:0}
.deco-rule{height:10px;background:repeating-linear-gradient(135deg,var(--primary) 0 2px,transparent 2px 8px);opacity:.5}
@media (prefers-reduced-motion:no-preference){@keyframes sz-rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}.rise{animation:sz-rise .6s ease-out both}.rise:nth-child(2){animation-delay:.08s}.rise:nth-child(3){animation-delay:.16s}}

.menu-board{padding:16px 16px 0}
.menu-board .m-hero{margin:0 0 -28px;padding:0 12px}
.menu-board .m-hero-img{width:100%;aspect-ratio:3/2;object-fit:cover;border-radius:14px;border:4px solid var(--surface);transform:rotate(-1.2deg)}
.menu-board .m-board{position:relative;padding:40px 18px 22px;border-radius:18px;background:var(--surface);
border:2px solid color-mix(in srgb,var(--primary) 55%,transparent);box-shadow:inset 0 0 0 6px var(--surface),inset 0 0 0 7px color-mix(in srgb,var(--primary) 35%,transparent)}
.menu-board .m-header{text-align:center}
.menu-board .m-shop{font-size:clamp(26px,8vw,36px);color:var(--primary);letter-spacing:.06em}
.menu-board .m-headline{margin-top:6px;font-size:20px}
.menu-board .m-subhead{margin-top:4px;font-size:15px;opacity:.8}
.menu-board .deco-rule{margin:16px 0 0}
.menu-board .m-list{list-style:none;margin:18px 0 0;padding:0;display:grid;gap:14px}
.menu-board .m-line{display:flex;flex-wrap:wrap;align-items:baseline;gap:0 8px}
.menu-board .m-name{flex:0 1 auto;min-width:0;font-size:18px}
.menu-board .m-leader{flex:1 1 24px;min-width:24px;border-bottom:2px dotted color-mix(in srgb,var(--text) 45%,transparent);transform:translateY(-4px)}
.menu-board .m-price{flex:0 1 auto;margin-left:auto;font-size:18px;font-weight:700;color:var(--primary)}
.menu-board .m-detail{margin-top:2px;font-size:15px;opacity:.85}
.menu-board .m-spec{opacity:.8}
.menu-board .m-blurb{margin-top:4px;color:var(--accent)}
.menu-board .m-claims{margin-top:20px;display:flex;justify-content:center}
.menu-board .m-claims .claims{justify-content:center}
.menu-board .m-strip{list-style:none;margin:16px 0 0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.menu-board .m-thumb{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:10px}
</style></head><body data-track="/api/track" data-slug="k7m2xq" data-version="ver_0001"><div class="page t-menu-board deco-line-art"><main class="menu-board"><figure class="m-hero"><img src="media/img_cake01-display.webp" alt="草莓奶油蛋糕" width="750" height="500" class="m-hero-img" fetchPriority="high" decoding="async"/></figure><section class="m-board" aria-label="菜单"><header class="m-header"><h1 class="fh m-shop" data-fact="shop.name">甜心烘焙坊</h1><p class="fh m-headline">一口就是春天</p><p class="m-subhead">当季草莓，配上轻盈奶油</p></header><div class="deco-rule" aria-hidden="true"></div><ul class="m-list"><li class="m-row"><div class="m-line"><h3 class="fh m-name" data-fact="items.ab12cd34.name">草莓奶油蛋糕</h3><span class="m-leader" aria-hidden="true"></span><span class="price m-price"><span data-fact="items.ab12cd34.price">¥128</span><span class="price-unit" data-fact="items.ab12cd34.price.unit">6 寸</span></span></div><div class="m-detail"><p class="m-spec" data-fact="items.ab12cd34.spec">约 450g</p><p data-fact="items.ab12cd34.description">当季草莓配动物奶油，每日现做。</p><ul class="tags"><li class="tag" data-fact="items.ab12cd34.tags.0">招牌</li><li class="tag" data-fact="items.ab12cd34.tags.1">需预订</li></ul><p class="m-blurb">切开那一刻，满满都是果香。</p></div></li></ul><div class="m-claims"><ul class="claims"><li class="claim" data-fact="extraClaims.0">当天现烤</li></ul></div></section><p class="closing">欢迎到店，我们等你来尝。</p></main><section class="shop-info" aria-label="店铺信息"><dl><div><dt>营业时间</dt><dd data-fact="shop.hours">每天 8:00-21:00</dd></div><div><dt>地址</dt><dd data-fact="shop.address">上海市徐汇区漕溪北路 88 号</dd></div><div><dt>电话</dt><dd data-fact="shop.phone">021-6488 1234</dd></div><div><dt>微信</dt><dd data-fact="shop.wechat">tianxin_bake</dd></div></dl></section><details class="fix"><summary>信息有误？告诉老板</summary><form id="sz-fix" data-api="/api/corrections" noValidate=""><label>哪一项有误<select name="field"><option value="items.ab12cd34.name">草莓奶油蛋糕 · 名称</option><option value="items.ab12cd34.price">草莓奶油蛋糕 · 价格</option><option 