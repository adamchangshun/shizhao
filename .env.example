# 实招 Shizhao 环境变量示例。复制为 .env.local 后按需修改。

# 模型服务：mock（默认，无需联网）或 openai-compatible
PROVIDER=mock
# 已验证的接口配置：qwen / glm / deepseek / ollama / generic
LLM_PROFILE=
# 任意 OpenAI 兼容接口，例如 Ollama：http://localhost:11434/v1
LLM_BASE_URL=
# Ollama 可留空
LLM_API_KEY=
LLM_MODEL_TEXT=
LLM_MODEL_VISION=
# 每千 token 单价（元），用于成本统计
LLM_PRICE_INPUT_PER_1K=0
LLM_PRICE_OUTPUT_PER_1K=0

# 公开访问域名（必需）
PUBLIC_BASE_URL=http://localhost:6688
# 商家界面管理口令（必需，至少 12 个字符，请改成你自己的随机字符串）
ADMIN_TOKEN=
# 运行时数据目录
DATA_DIR=./data

# 文案检查 API 的 Key 列表（逗号分隔），持有者可使用模型判定层与行业规则包
GUARD_API_KEYS=
# 每个 Key 每日最多请求数
GUARD_KEY_DAILY_LIMIT=2000
# Only enable behind a trusted proxy that overwrites X-Real-IP and blocks direct access.
GUARD_TRUST_PROXY=false

# 长图功能预留；本次不实现，保持关闭
LONG_IMAGE_ENABLED=false

# 生成任务超时（毫秒）：单个阶段默认 60 秒，整个任务默认 180 秒
JOB_STAGE_TIMEOUT_MS=60000
JOB_TOTAL_TIMEOUT_MS=180000

# 仅当反向代理覆盖 X-Real-IP、禁止绕过代理直连时启用；默认不信任客户端 IP 头
TRACK_TRUST_PROXY=false
