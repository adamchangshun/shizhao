{
  "name": "shizhao",
  "version": "0.1.0",
  "private": true,
  "description": "实招 Shizhao：AI 只改颜值，不改事实的小商家宣传页生成器",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 6688",
    "build": "next build",
    "start": "next start -p 6688",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/fact-guard",
    "lint": "eslint .",
    "format": "prettier --write .",
    "pretest": "playwright install --only-shell chromium",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx lib/db/migrate-cli.ts",
    "render:demo": "tsx --tsconfig tsconfig.scripts.json scripts/render-demo.tsx"
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "@fontsource/zcool-kuaile": "^5.3.0",
    "@fontsource/zcool-xiaowei": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "busboy": "^1.6.0",
    "drizzle-orm": "^0.45.4",
    "file-type": "^22.1.1",
    "heic-convert": "^2.1.0",
    "lxgw-wenkai-webfont": "^1.7.0",
    "nanoid": "^6.0.2",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/busboy": "^1.5.5",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.27",
    "node-html-parser": "^9.0.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
