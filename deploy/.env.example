# 实招 Shizhao 生产环境配置模板。复制为 deploy/.env 并把权限设为 600（见 deploy/README.md 第 6 步）。
# deploy/.env 不进 git，也不进镜像（.gitignore 与 .dockerignore 都排除了 .env*）。

# 你自己的独立域名（不要用 *.github.io、*.vercel.app 等共享父域名）
DOMAIN=shop.example.com
# 证书到期提醒邮箱
ACME_EMAIL=you@example.com

# 必须与 DOMAIN 一致，二维码内容由它生成
PUBLIC_BASE_URL=https://shop.example.com
# 管理口令：用 `openssl rand -base64 32 | tr -d '/+=' | cut -c1-32` 生成，至少 12 个字符
ADMIN_TOKEN=

# 模型服务：mock（演示，无需 Key）或 openai-compatible
PROVIDER=mock
LLM_PROFILE=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_TEXT=
LLM_MODEL_VISION=
LLM_PRICE_INPUT_PER_1K=0
LLM_PRICE_OUTPUT_PER_1K=0

# 文案检查 API 的 Key（逗号分隔，可留空）
GUARD_API_KEYS=
GUARD_KEY_DAILY_LIMIT=2000

# 长图需要镜像带 Chromium（构建时 WITH_QA=true）且内存充足；2 核 4G 建议先保持 false
LONG_IMAGE_ENABLED=false
# 构建镜像时是否安装 Chromium（供长图使用）
WITH_QA=false

JOB_STAGE_TIMEOUT_MS=60000
JOB_TOTAL_TIMEOUT_MS=180000
